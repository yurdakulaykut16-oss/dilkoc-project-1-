# Ücretsiz/key'siz AI ses: Puter.js üzerinden ElevenLabs/Speechify/xAI TTS varsayılan olarak aktiftir.
# Kapatmak isterseniz:
# VITE_DISABLE_PUTER_TTS=true
# PC'de bulut AI ses cevap vermezse uygulama sessiz kalmasın diye cihaz/tarayıcı sesi yedek olarak açıktır.
# Bu yedeği tamamen kapatmak isterseniz:
# VITE_ALLOW_DEVICE_TTS=false

# ElevenLabs ses ayarı (opsiyonel)
# Varsayılan bot sesi: kullanıcının istediği ElevenLabs voice ID
VITE_ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
VITE_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ÖNERİLEN: API anahtarını Android/SPA içine koymak yerine güvenli proxy kullanın.
# Proxy, POST gövdesinde { text, voiceId, modelId, lang, voice_settings } alıp audio/mpeg döndürmelidir.
# VITE_ELEVENLABS_PROXY_URL=https://your-secure-proxy.example.com/tts

# Sadece geliştirme/test için doğrudan API anahtarı kullanımı.
# Bu değişkenle build alırsanız anahtar istemci paketine gömülür; üretim için önerilmez.
# VITE_ELEVENLABS_API_KEY=
